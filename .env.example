# Copy to .env and change every value for a real pilot.
POLICE_ONVIF_USER=uvp-viewer
POLICE_ONVIF_PASS=police-view-only
MUNI_API_USER=uvp-viewer
MUNI_API_PASS=muni-view-only
INTERNAL_SECRET=change-me-internal
TOKEN_SECRET=change-me-token-use-at-least-32-random-characters
RELAY_INTERNAL_USER=uvp-internal
RELAY_INTERNAL_PASS=change-me-relay
POSTGRES_PASSWORD=change-me-db

# State(s) where the cameras are installed; an unsure look-alike state code (HP, NP, WP) is read as this one
ANPR_HOME_STATES=MP
# Low-light / IR CCTV: auto-detect night frames and enhance (auto | on | off)
ANPR_NIGHT=auto

# ---- Video archive (event clips, plate crops, recordings of ANPR cameras) ----
# OBJECT_STORAGE=local keeps it under the data volume. For Oracle Cloud Object Storage use its
# Amazon S3 Compatibility API: create a "Customer Secret Key" for your user (Identity > Users >
# Auth Tokens / Customer Secret Keys) -> access key + secret; endpoint uses your tenancy namespace.
OBJECT_STORAGE=local
#OBJECT_STORAGE=s3
#S3_ENDPOINT=https://<namespace>.compat.objectstorage.ap-mumbai-1.oraclecloud.com
#S3_REGION=ap-mumbai-1
#S3_BUCKET=uvp-video
#S3_ACCESS_KEY=<customer secret key: access key>
#S3_SECRET_KEY=<customer secret key: secret>
#S3_PREFIX=pilot
#S3_PATH_STYLE=1
# Which cameras are recorded continuously: none | anpr (default) | all. Per source/camera `record:` in sources.yaml overrides.
RECORD_MODE=anpr
RECORD_SEGMENT_S=60
RECORD_LOCAL_KEEP=6h
CLIP_BEFORE_S=4
CLIP_AFTER_S=4

# ---- Security (phase 1) ----
# TLS front door: docker compose --profile tls up -d ; then open https://PUBLIC_HOST
PUBLIC_HOST=localhost
#RELAY_PUBLIC_BASE=https://localhost/relay
# Secrets can come from files (NAME_FILE=/run/secrets/name) or HashiCorp Vault KV v2 instead of this file:
#VAULT_ADDR=https://vault.example.gov.in
#VAULT_TOKEN_FILE=/run/secrets/vault-token
#VAULT_KV_PATH=secret/data/uvp
# Server-side encryption for the video archive bucket (AES256 or aws:kms)
#S3_SSE=AES256
# Archival policy (Admin -> Archival): archived objects / row exports go under this prefix, optionally in a
# colder storage class (OCI: InfrequentAccess or Archive; AWS: STANDARD_IA / GLACIER_IR). Nightly run hour (IST).
#ARCHIVAL_COLD_PREFIX=cold
#S3_COLD_CLASS=InfrequentAccess
#ARCHIVAL_HOUR_IST=2
# Personal data: blur faces in stored evidence frames; mask plates for users without plate_search
PII_BLUR_FACES=1
PII_MASK_PLATES=1
# Login lockout
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_S=900
# OIDC client secret referenced from config/auth.yaml
#OIDC_CLIENT_ID=
#OIDC_CLIENT_SECRET=

# ---- Analytics (phase 3) ----
ANALYTICS_ENABLED=1
ANALYTICS_FPS=2
# Customer-supplied classifiers (ONNX + labels .txt beside it); leave empty to disable those checks
#ANALYTICS_HELMET_MODEL=platform/models/helmet.onnx
#ANALYTICS_MAKE_MODEL_MODEL=platform/models/make_model.onnx
# Hotlist feed credential (config/hotlists.yaml) and e-challan hand-off
HOTLIST_API_KEY=demo
#ECHALLAN_WEBHOOK_URL=http://sim-hotlist:18095/echallan
#ECHALLAN_WEBHOOK_SECRET=change-me-echallan

# ---- Operations & integration (phase 4) ----
# Ticketing (Jira / ServiceNow / any intake accepting JSON) for camera outages and image-quality degradation
#TICKET_WEBHOOK_URL=https://helpdesk.example.gov.in/api/intake
#TICKET_WEBHOOK_SECRET=change-me-ticket
OUTAGE_TICKET_MINUTES=15
QUALITY_INTERVAL_S=300
# Vahan registration lookup connector ({plate} is substituted); simulator: http://sim-hotlist:18095/vahan/{plate}
#VAHAN_URL=http://sim-hotlist:18095/vahan/{plate}
#VAHAN_HEADERS={"X-API-Key": "demo"}
# Notification channel secrets referenced from config/notify.yaml
#SMTP_USER=
#SMTP_PASS=
#SMS_API_KEY=
# Voice-call alerts through a BulkOBD outbound dialer (config/notify.yaml channel voice_call)
#VOICE_OBD_URL=http://180.150.248.111:8096/OBDSEA
#VOICE_OBD_USER=
#VOICE_OBD_PASS=
#VOICE_OBD_LANG=1                             # TTS language code from the dialer panel
#VOICE_OBD_DNID=                              # DNID / caller number given by the OBD provider
#VOICE_CALLBACK_KEY=change-me-long-random      # give the provider: https://<server>/api/integrations/voice/callback?key=<this>
#WA_PHONE_ID=
#WA_TOKEN=
#CAD_WEBHOOK_SECRET=

# ---- HA & scale (phase 5) ----
# Relay cluster (docker compose --profile ha adds relay-b). Leave empty for a single relay.
#RELAY_APIS=relay=http://relay:9997,relay-b=http://relay-b:9997
#RELAY_RTSPS=relay=rtsp://relay:8554,relay-b=rtsp://relay-b:8554
#RELAY_PLAYBACKS=relay=http://relay:9996,relay-b=http://relay-b:9996
#RELAY_PUBLIC_HOSTS=relay=10.10.1.20,relay-b=10.10.1.21
# ANPR sharding: run several anpr services with ANPR_SHARD=0/2 and 1/2 (compose overrides per service)
ANPR_SHARD=0/1
# Edge ANPR node (reads cameras directly, buffers events offline, ships crops inline)
#EDGE=1
#EDGE_CAMERAS=junction-7=rtsp://viewer:pass@10.5.0.7:554/Streaming/Channels/101
#EDGE_DEPARTMENT=Police
#API_URL=https://cctv.example.gov.in
GRAFANA_PASSWORD=admin

# 3-node PostgreSQL cluster (deploy/postgres-ha): point the platform at HAProxy instead of the single container
#PG_HOST=pg-haproxy
#PG_PORT=5000
